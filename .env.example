# Kopieren nach .env – Keys bleiben ausschließlich serverseitig.
PORT=3000
# Nur lokal erreichbar. Für Zugriff aus dem Netz bewusst auf 0.0.0.0 stellen (die Regie hat keinen Login!).
HOST=127.0.0.1

MOCK_MODE=true
# Takt des Fake-Transkripts im Mock-Modus (Sekunden) – kurz, damit die Demo zügig läuft.
MOCK_CHUNK_SECONDS=8

# Echte Anbieter (MOCK_MODE=false).
# Transkription: Mistral Voxtral
MISTRAL_API_KEY=
# Sprachmodell, OpenAI-kompatibel. Leer lassen = Mistral mit demselben Schlüssel (mistral-medium-latest).
# Für Broki (Open WebUI): LLM_BASE_URL=https://<broki-host>  LLM_CHAT_PATH=/api/chat/completions  LLM_API_KEY=<Broki-Key>  LLM_MODEL=<Modell-ID>
LLM_BASE_URL=
LLM_CHAT_PATH=
LLM_API_KEY=
LLM_MODEL=
STT_MODEL=voxtral-mini-transcribe-3-0
# Der Takt der Transkription wird in der Admin-Ansicht unter „Erweitert" eingestellt (Standard 30 s).

# Mock-Anbieter, aber echte Mikrofon-Aufnahme im Browser (testet Mikro + Upload ohne API-Key).
MOCK_MIKRO=false
