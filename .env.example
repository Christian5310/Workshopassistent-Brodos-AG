# Kopieren nach .env – Keys bleiben ausschließlich serverseitig.
PORT=3000
# Nur lokal erreichbar. Für Zugriff aus dem Netz bewusst auf 0.0.0.0 stellen (die Regie hat keinen Login!).
HOST=127.0.0.1

MOCK_MODE=true
# Takt des Fake-Transkripts im Mock-Modus (Sekunden) – kurz, damit die Demo zügig läuft.
MOCK_CHUNK_SECONDS=8

# ── Komplett lokal (ohne Cloud, ohne Lizenzkosten) – Anleitung: docs/lokal-einrichten.md ──
# Zum Einschalten die Raute vor den Zeilen entfernen.
# Transkription: im Admin unter Erweitert umschaltbar (Mistral, Whisper large-v3, Whisper Turbo).
# Start-Vorgabe Whisper statt Mistral (lokal/whisper_server.py, faster-whisper):
# STT_ANBIETER=whisper
# Optional andere Whisper-Modelle (Name oder Hugging-Face-ID):
# WHISPER_LARGE=large-v3
# WHISPER_TURBO=large-v3-turbo
# Sprachmodell über Ollama, Modell mit Apache-2.0-Lizenz (kleiner: mistral-nemo):
# LLM_ANBIETER=ollama
# LLM_MODEL=mistral-small3.2
# Optional: Kontextlänge, Obergrenze und Wartezeit für das lokale Modell
# LLM_KONTEXT=16384
# LLM_KONTEXT_MAX=65536
# LLM_ZEITLIMIT_SEKUNDEN=300

# Echte Anbieter (MOCK_MODE=false).
# Transkription: Mistral Voxtral
MISTRAL_API_KEY=
# Sprachmodell, OpenAI-kompatibel. Leer lassen = Mistral mit demselben Schlüssel (mistral-medium-latest).
# Für Broki (Open WebUI): LLM_BASE_URL=https://<broki-host>  LLM_CHAT_PATH=/api/chat/completions  LLM_API_KEY=<Broki-Key>  LLM_MODEL=<Modell-ID>
LLM_BASE_URL=
LLM_CHAT_PATH=
LLM_API_KEY=
LLM_MODEL=
# Optional: kleineres, schnelleres Modell nur für Merlins Befehle (Standard bei Mistral: mistral-small-latest)
LLM_MODEL_MERLIN=
STT_MODEL=voxtral-mini-transcribe-3-0
# Der Takt der Transkription wird in der Admin-Ansicht unter „Erweitert" eingestellt (Standard 30 s).

# Mock-Anbieter, aber echte Mikrofon-Aufnahme im Browser (testet Mikro + Upload ohne API-Key).
MOCK_MIKRO=false
