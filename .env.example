# Kopieren nach .env – Keys bleiben ausschließlich serverseitig.
PORT=3000
# Nur lokal erreichbar. Für Zugriff aus dem Netz bewusst auf 0.0.0.0 stellen (die Regie hat keinen Login!).
HOST=127.0.0.1

MOCK_MODE=true
# Takt des Fake-Transkripts im Mock-Modus (Sekunden) – kurz, damit die Demo zügig läuft.
MOCK_CHUNK_SECONDS=8

# Ab Schritt 3–6 (echte Anbieter):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MISTRAL_API_KEY=
STT_MODEL=voxtral-mini-transcribe-3-0
CHUNK_SECONDS=60

# Mock-Anbieter, aber echte Mikrofon-Aufnahme im Browser (testet Mikro + Upload ohne API-Key).
MOCK_MIKRO=false
